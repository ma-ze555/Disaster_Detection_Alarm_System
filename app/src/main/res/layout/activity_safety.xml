<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1a2a1a"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="56sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Glad You're Safe!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Follow these safety measures to stay protected"
                android:textSize="13sp"
                android:textColor="@color/text_sub"
                android:gravity="center"/>
        </LinearLayout>

        <!-- During Earthquake -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 During the Earthquake"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/red_primary"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. DROP to your hands and knees immediately\n\n2. Take COVER under a sturdy desk or table, or against an interior wall\n\n3. HOLD ON and protect your head and neck with your arms\n\n4. Stay away from windows, exterior walls and anything that could fall\n\n5. Do NOT run outside during shaking"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- After Earthquake -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏃 After the Earthquake"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/yellow"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Check yourself and others for injuries\n\n2. Evacuate the building carefully — watch for fallen debris\n\n3. Do NOT use elevators\n\n4. Move to an open area away from buildings and power lines\n\n5. Be prepared for aftershocks\n\n6. Do NOT re-enter damaged buildings\n\n7. Follow instructions from emergency authorities"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Emergency Numbers -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 Emergency Numbers"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚒 Fire: 101\n🚑 Ambulance: 108\n👮 Police: 100\n🆘 Disaster Management: 1078\n📱 National Emergency: 112"
                    android:textSize="14sp"
                    android:textColor="@color/text_sub"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✅ I Understand"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
