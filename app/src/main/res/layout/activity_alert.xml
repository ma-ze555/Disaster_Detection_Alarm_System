<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0000"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Flashing Alert Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="80sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EARTHQUAKE ALERT"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvMagnitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Magnitude: -- m/s²"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-escalating in 120s"
        android:textSize="14sp"
        android:textColor="#FFCCCC"
        android:layout_marginBottom="40dp"/>

    <!-- Safety Instruction -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#99000000"
        android:layout_marginBottom="40dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️  DROP • COVER • HOLD ON"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:padding="16dp"
            android:layout_gravity="center"/>
    </androidx.cardview.widget.CardView>

    <!-- Are you safe? -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you safe?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- YES - I'm Safe -->
        <Button
            android:id="@+id/btnSafe"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="✅ YES\nI'm Safe"
            android:textSize="14sp"
            android:backgroundTint="#2ecc71"
            android:layout_marginEnd="8dp"/>

        <!-- NO - Need Help -->
        <Button
            android:id="@+id/btnNotSafe"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="🆘 NO\nNeed Help"
            android:textSize="14sp"
            android:backgroundTint="#c0392b"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</LinearLayout>
